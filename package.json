{
  "name": "marketing-team-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "echo 'Skipping lint'",
    "postinstall": "prisma generate",
    "test:meetings": "tsx --test tests/meeting-assignments.test.ts",
    "test:shared-assignments": "tsx --test tests/meeting-assignments.test.ts tests/dashboard-shared-assignments.test.ts tests/content-metrics-assignments.test.ts tests/notification-assignments.test.ts",
    "test:performance-security": "tsx --test tests/performance-security.test.ts",
    "test:avatars": "tsx --test tests/member-avatar.test.ts",
    "test:consistency": "tsx --test tests/date-status-consistency.test.ts",
    "test:release": "npm run test:shared-assignments && npm run test:performance-security && npm run test:avatars && npm run test:consistency && node --test tests/production-migration-runner.test.cjs tests/release-environment.test.cjs"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/react-datepicker": "^6.2.0",
    "date-fns": "^4.4.0",
    "google-auth-library": "^10.7.0",
    "google-spreadsheet": "^5.3.0",
    "next": "16.4.1",
    "pg": "^8.22.0",
    "puppeteer": "^25.2.1",
    "react": "19.2.4",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.6.0",
    "react-quill-new": "^3.8.3",
    "recharts": "^3.8.1",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "^5.22.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
