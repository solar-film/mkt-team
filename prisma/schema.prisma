generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TeamMember {
  id        String    @id @default(cuid())
  name      String
  role      String
  company   String    @default("GFS")
  status    String    @default("active")
  avatar    String? 
  tasks     Task[]
  kpis      KPI[]
  contents  Content[]
  metrics   ContentMetric[]
  channelMetrics ChannelMetric[]
  credential MemberCredential?
  sessions  MemberSession[]
  evaluations MemberEvaluation[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      String     @default("todo")
  priority    String     @default("medium")
  startDate   DateTime?
  deadline    DateTime?
  company     String     @default("GFS")
  link        String?
  kpiId       String?
  meetingId   String?
  memberId    String
  memberIds   String[]   @default([])
  companies   String[]   @default([])
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // Work review for KPI กลาง (see src/lib/work-review.ts)
  submittedAt  DateTime?
  waitingOn    String?
  firstReview  String?
  reviseReason String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([memberId])
  @@index([memberIds], type: Gin)
  @@index([meetingId])
  @@index([company])
  @@index([status])
}

model KPI {
  id          String     @id @default(cuid())
  name        String
  target      Float
  current     Float      @default(0)
  unit        String
  month       Int
  year        Int
  company     String     @default("GFS")
  memberId    String
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Content {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        String
  platform    String
  company     String     @default("GFS")
  status      String     @default("draft")
  publishDate DateTime?
  link        String?
  kpiId       String?
  meetingId   String?
  memberId    String
  memberIds   String[]   @default([])
  companies   String[]   @default([])
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  platformPostId String?
  permalink      String?
  metrics        ContentMetric[]
  // Work review for KPI กลาง (see src/lib/work-review.ts)
  submittedAt  DateTime?
  waitingOn    String?
  firstReview  String?
  reviseReason String?
  promotion    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@index([memberIds], type: Gin)
}

/// Monthly evaluation per member, drafted by มะลิ (AI) and shown on the KPI กลาง page.
model MemberEvaluation {
  id           String     @id @default(cuid())
  memberId     String
  member       TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  month        Int
  year         Int
  summary      String
  strengths    String?
  improvements String?
  nextSteps    String?
  source       String     @default("มะลิ")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([memberId, year, month])
  @@index([year, month])
}

model ContentMetric {
  id            String   @id @default(cuid())
  contentId     String
  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  snapshot      String
  recordedAt    DateTime @default(now())
  views         Int?
  reach         Int?
  likes         Int?
  comments      Int?
  shares        Int?
  saves         Int?
  follows       Int?
  linkClicks    Int?
  profileVisits Int?
  messages      Int?
  avgWatchSec   Float?
  adSpend       Float    @default(0)
  source        String   @default("manual")
  recordedById  String?
  recordedBy    TeamMember? @relation(fields: [recordedById], references: [id])
  note          String?
  
  @@unique([contentId, snapshot])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  time        String?
  type        String
  company     String   @default("GFS")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  time        String?
  company     String   @default("GFS")
  status      String   @default("upcoming")
  attendees   String?
  agenda      String?
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([company])
}

model IdeaNote {
  id             String   @id @default(cuid())
  title          String
  description    String?
  memberId       String?
  recommendedFor String?
  company        String?
  status         String   @default("pending")
  priority       String   @default("normal")
  deadline       DateTime?
  
  category       String   @default("idea") // 'idea', 'task', 'content'
  platform       String?  // for content
  kpiId          String?  // to link to KPI

  checklists     IdeaChecklist[]
  attachments    IdeaAttachment[]
  comments       IdeaComment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model IdeaChecklist {
  id         String   @id @default(cuid())
  title      String
  isDone     Boolean  @default(false)
  deadline   DateTime?
  assigneeId String?
  ideaNoteId String
  ideaNote   IdeaNote @relation(fields: [ideaNoteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ideaNoteId])
}

model IdeaAttachment {
  id         String   @id @default(cuid())
  name       String
  type       String
  url        String // Can store Base64
  ideaNoteId String
  ideaNote   IdeaNote @relation(fields: [ideaNoteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([ideaNoteId])
}

model IdeaComment {
  id         String   @id @default(cuid())
  text       String
  memberId   String
  ideaNoteId String
  ideaNote   IdeaNote @relation(fields: [ideaNoteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([ideaNoteId])
}

model Channel {
  id        String          @id @default(cuid())
  name      String
  platform  String
  createdAt DateTime        @default(now())
  metrics   ChannelMetric[]
}

model ChannelMetric {
  id           String      @id @default(cuid())
  channelId    String
  channel      Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  month        Int
  year         Int
  followers    Int?
  reach        Int?
  messages     Int?
  adSpend      Float?
  recordedById String?
  recordedBy   TeamMember? @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedDate DateTime?

  @@unique([channelId, month, year])
}

// PIN hashes are kept out of TeamMember so member queries never return them.
model MemberCredential {
  memberId  String     @id
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pinHash   String
  updatedAt DateTime   @default(now()) @updatedAt
}

model MemberSession {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?

  @@index([memberId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  kind      String
  memberId  String?
  success   Boolean
  reason    String
  ip        String   @default("")
  userAgent String?
  createdAt DateTime @default(now())

  @@index([kind, memberId, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

// Daily ad results per campaign, copied from Windsor.ai once a day (see src/lib/windsor.ts).
// One row per platform + account + campaign + day; a sync replaces its whole date window.
model AdDaily {
  id           String   @id @default(cuid())
  platform     String
  accountId    String
  accountName  String
  campaignId   String
  campaignName String
  date         DateTime @db.Date
  month        String
  currency     String   @default("THB")
  spend        Float    @default(0)
  impressions  Float    @default(0)
  clicks       Float    @default(0)
  leads        Float    @default(0)
  messages     Float    @default(0)
  syncedAt     DateTime @default(now())

  @@unique([platform, accountId, campaignId, date])
  @@index([platform, month])
  @@index([month])
}

// One row per Windsor pull, so the pages can say how fresh the numbers are and why a pull failed.
model AdSyncRun {
  id         String    @id @default(cuid())
  platform   String
  trigger    String
  dateFrom   DateTime  @db.Date
  dateTo     DateTime  @db.Date
  ok         Boolean   @default(false)
  rows       Int       @default(0)
  message    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([platform, startedAt])
}

// Google Ads keywords and search terms, one row per month + account + text, kept to the
// biggest spenders per account so a busy month stays small. A sync replaces whole months.
model AdKeyword {
  id          String   @id @default(cuid())
  kind        String
  month       String
  accountId   String
  accountName String
  text        String
  matchType   String   @default("")
  spend       Float    @default(0)
  impressions Float    @default(0)
  clicks      Float    @default(0)
  conversions Float    @default(0)
  syncedAt    DateTime @default(now())

  @@unique([kind, month, accountId, text, matchType])
  @@index([month, kind])
}

// Daily contacts (one customer once per day) per channel account, for the ข้อมูลการติดต่อ pages.
// LINE / Facebook / Instagram are copied from GOOD CRM's intake counts (src/lib/contact-sync.ts);
// phone rows come from uploaded call-log files. A pull or upload replaces its own date window.
model ContactDaily {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  month       String
  channel     String
  company     String
  account     String
  contacts    Int      @default(0)
  newContacts Int?
  source      String
  syncedAt    DateTime @default(now())

  @@unique([channel, company, account, date])
  @@index([month])
}

// One row per GOOD CRM pull or call-log upload: freshness and the reason a pull failed.
model ContactSyncRun {
  id         String    @id @default(cuid())
  source     String
  trigger    String
  dateFrom   DateTime  @db.Date
  dateTo     DateTime  @db.Date
  ok         Boolean   @default(false)
  rows       Int       @default(0)
  message    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([source, startedAt])
}

/// Facebook page posts copied from Windsor (facebook_organic) to fill each content item's D+7 reach.
/// contentId is the matched Content row (no foreign key: a deleted content just leaves the post unmatched).
model FacebookPost {
  id          String   @id
  pageId      String
  createdTime DateTime
  message     String   @default("")
  reach       Int?
  reactions   Int?
  comments    Int?
  contentId   String?
  matchedBy   String?
  fetchedAt   DateTime @default(now())

  @@index([createdTime])
  @@index([contentId])
}
