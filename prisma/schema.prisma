generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TeamMember {
  id        String    @id @default(cuid())
  name      String
  role      String
  company   String    @default("GFS")
  status    String    @default("active")
  avatar    String?   @db.Text
  tasks     Task[]
  kpis      KPI[]
  contents  Content[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      String     @default("todo")
  priority    String     @default("medium")
  startDate   DateTime?
  deadline    DateTime?
  company     String     @default("GFS")
  link        String?
  kpiId       String?
  meetingId   String?
  memberId    String
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([memberId])
  @@index([meetingId])
  @@index([company])
  @@index([status])
}

model KPI {
  id          String     @id @default(cuid())
  name        String
  description String?    @db.Text
  target      Float
  current     Float      @default(0)
  unit        String
  month       Int
  year        Int
  company     String     @default("GFS")
  memberId    String
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Content {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        String
  platform    String
  company     String     @default("GFS")
  status      String     @default("draft")
  publishDate DateTime?
  link        String?
  kpiId       String?
  meetingId   String?
  memberId    String
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  time        String?
  type        String
  company     String   @default("GFS")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  time        String?
  company     String   @default("GFS")
  status      String   @default("upcoming")
  attendees   String?
  agenda      String?  @db.Text
  notes       String?  @db.Text
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([company])
}

model IdeaNote {
  id             String   @id @default(cuid())
  title          String
  description    String?  @db.Text
  memberId       String?
  recommendedFor String?
  company        String?
  status         String   @default("pending")
  priority       String   @default("normal")
  deadline       DateTime?
  
  category       String   @default("idea") // 'idea', 'task', 'content'
  platform       String?  // for content
  kpiId          String?  // to link to KPI

  checklists     IdeaChecklist[]
  attachments    IdeaAttachment[]
  comments       IdeaComment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model IdeaChecklist {
  id         String   @id @default(cuid())
  title      String
  isDone     Boolean  @default(false)
  deadline   DateTime?
  assigneeId String?
  ideaNoteId String
  ideaNote   IdeaNote @relation(fields: [ideaNoteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ideaNoteId])
}

model IdeaAttachment {
  id         String   @id @default(cuid())
  name       String
  type       String
  url        String   @db.Text // Can store Base64
  ideaNoteId String
  ideaNote   IdeaNote @relation(fields: [ideaNoteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([ideaNoteId])
}

model IdeaComment {
  id         String   @id @default(cuid())
  text       String   @db.Text
  memberId   String
  ideaNoteId String
  ideaNote   IdeaNote @relation(fields: [ideaNoteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([ideaNoteId])
}
